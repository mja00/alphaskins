{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mja00.alphaskins.fabric.AlphaskinsFabric"
    ]
  },
  "mixins": [
    "alphaskins.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "fabric-api": "*"
  }
}
